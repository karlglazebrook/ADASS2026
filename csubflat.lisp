;; csubflat.lisp -- SBCL, typed, kernel indexes the 2D array's storage
;; vector directly.  (aref a iy ix) on a (simple-array double-float (* *))
;; reloads the data-vector pointer and the row length and multiplies on every
;; access; SBCL does not hoist these.  Taking the storage vector once per call
;; and the row base once per row leaves a load, two fadds and a store per element.
(declaim (optimize (speed 3) (safety 0) (debug 0) (space 0)))

(deftype matrix () '(simple-array double-float (* *)))
(deftype dvec   () '(simple-array double-float (*)))

(declaim (ftype (function (matrix fixnum fixnum matrix) (values)) subr))
(defun subr (in-arr nx ny out-arr)
   (declare (type matrix in-arr out-arr) (type fixnum nx ny))
   (let ((in-v  (sb-ext:array-storage-vector in-arr))
         (out-v (sb-ext:array-storage-vector out-arr)))
      (declare (type dvec in-v out-v))
      (dotimes (iy ny)
         (declare (type fixnum iy))
         (let ((fiy  (coerce iy 'double-float))
               (base (the fixnum (* iy nx))))
            (declare (type double-float fiy) (type fixnum base))
            (dotimes (ix nx)
               (declare (type fixnum ix))
               (let ((k (the fixnum (+ base ix))))
                  (setf (aref out-v k)
                        (+ (aref in-v k) (coerce ix 'double-float) fiy)))))))
   (values))

(defun main ()
   (let* ((args (cdr sb-ext:*posix-argv*))
          (nrpt (if (>= (length args) 1) (parse-integer (nth 0 args)) 1000))
          (nx   (if (>= (length args) 2) (parse-integer (nth 1 args)) 2000))
          (ny   (if (>= (length args) 3) (parse-integer (nth 2 args)) 10))
          (in-arr  (make-array (list ny nx) :element-type 'double-float :initial-element 0d0))
          (out-arr (make-array (list ny nx) :element-type 'double-float :initial-element 0d0)))
      (declare (type matrix in-arr out-arr) (type fixnum nx ny nrpt))
      (dotimes (iy ny)
         (dotimes (ix nx)
            (setf (aref in-arr iy ix) (coerce (- (+ nx ny) ix iy) 'double-float))))
      (format t "Arrays ~A by ~A count ~A~%" nx ny nrpt)
      (dotimes (r nrpt) (subr in-arr nx ny out-arr))
      (block check
         (dotimes (iy ny)
            (dotimes (ix nx)
               (let ((got (aref out-arr iy ix))
                     (want (+ (aref in-arr iy ix) ix iy)))
                  (unless (= got want)
                     (format t "Error: ~A ~A ~A ~A~%" got ix iy (aref in-arr iy ix))
                     (return-from check))))))))
(main)
